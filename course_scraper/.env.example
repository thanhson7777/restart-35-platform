# ── MongoDB ────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
DB_NAME=restart35

# ── AI Services (optional — for enhanced field filling) ────────────
OPENAI_API_KEY=
# ESCO service (uses existing ai-service skill_normalizer.py)
# Set to the absolute path of the backend folder if running outside Docker
AI_SERVICE_PATH=

# ── Proxies (optional — leave empty for direct connection) ───────────
# Format: http://user:pass@host:port  (one per line)
# PROXY_LIST=http://proxy1:8080
# PROXY_LIST=http://proxy2:8080

# ── LinkedIn Learning Auth (optional) ──────────────────────────────
# Get cookies from a logged-in LinkedIn Learning session
# Format: li_at=XXXX;JSESSIONID=XXXX
LINKEDIN_LEARNING_COOKIE=

# ── Scraping limits ────────────────────────────────────────────────
MAX_ITEMS_PER_PLATFORM=500
DEFAULT_DELAY_SECONDS=3.0

# ── Development ────────────────────────────────────────────────────
DEV_MODE=false
# Set to true to use cached responses (fast iteration, no network)
