# =============================================================================
# Restart-35 Platform Environment Variables
# =============================================================================

# API Configuration
VITE_API_URL=http://localhost:5000

# =============================================================================
# FEATURE FLAGS (Phase 2+)
# =============================================================================

# Enable Federated Career Analysis API (combines RAG + Skill Gap)
# Default: false (use legacy separate API calls)
VITE_USE_FEDERATED_API=false

# Enable new Skill Gap UI component
# Default: false (use existing UI)
VITE_USE_NEW_SKILL_GAP=false

# Enable consistency checking between RAG and Skill Gap results
# Default: true
VITE_ENABLE_CONSISTENCY_CHECK=true

# Enable caching for analysis results
# Default: true
VITE_ENABLE_CACHING=true

# Rollout percentage for federated API (0-100)
# 0 = disabled, 100 = all users
# Default: 0
VITE_ROLLOUT_PERCENTAGE=0

# =============================================================================
# ANALYTICS & MONITORING
# =============================================================================

# Enable analytics tracking
VITE_ENABLE_ANALYTICS=true

# Enable performance monitoring
VITE_ENABLE_MONITORING=true
