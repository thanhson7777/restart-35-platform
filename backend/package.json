{
  "name": "restart-35-platform",
  "private": true,
  "version": "1.0.0",
  "author": "thanh son",
  "description": "",
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "lint": "eslint src --ext js --report-unused-disable-directives --max-warnings 0",
    "clean": "rm -rf build && mkdir build",
    "build-babel": "babel ./src -d ./build/src",
    "build": "npm run clean && npm run build-babel",
    "production": "npm run build && cross-env BUILD_MODE=production node ./build/src/server.js",
    "dev": "cross-env BUILD_MODE=dev nodemon --exec babel-node ./src/server.js",
    "sync:esco": "cross-env BUILD_MODE=dev babel-node ./src/scripts/syncEscoData.js",
    "sync:esco:full": "cross-env BUILD_MODE=dev babel-node ./src/scripts/syncEscoDataFull.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.22.10",
    "@getbrevo/brevo": "^2.1.1",
    "async-exit-hook": "^2.0.1",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.3.2",
    "joi": "^17.10.2",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "memory-cache": "^0.2.0",
    "mongodb": "^6.0.0",
    "ms": "^2.1.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "recharts": "^3.8.1",
    "streamifier": "^0.1.1",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/cli": "^7.22.10",
    "@babel/core": "^7.22.10",
    "@babel/eslint-parser": "^7.22.10",
    "@babel/node": "^7.22.10",
    "@babel/plugin-transform-runtime": "^7.22.10",
    "@babel/preset-env": "^7.22.10",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.47.0",
    "nodemon": "^3.0.1"
  }
}
